# Application
ENV=development
LOG_LEVEL=INFO

# Database (asyncpg). Host "postgres" is the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/leadengine

# Redis (cache + queue). Host "redis" is the docker-compose service name.
REDIS_URL=redis://redis:6379/0

# Groq (LLM — function calling for the onboarding agents)
GROQ_API_KEY=

# SerpAPI (Google Search — used by tenant onboarding pipeline to discover website pages)
SERPAPI_API_KEY=

# Auth0 (managed auth provider — see auth/)
#   AUTH0_DOMAIN         e.g. your-tenant.us.auth0.com  (no https://, no trailing slash)
#   AUTH0_AUDIENCE       the API Identifier from Auth0 -> APIs
#   AUTH0_SPA_CLIENT_ID  SPA app Client ID, used by the /docs "Authorize" button
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_SPA_CLIENT_ID=
# AUTH_CLAIM_NAMESPACE defaults to https://leadengine/ — override only if your Auth0 Action uses another namespace.
# AUTH0_ALGORITHMS defaults to ["RS256"] — override (JSON list) only if needed.

# Meta / Facebook (webhooks + OAuth for WhatsApp, Facebook DMs, Instagram DMs)
#
#   META_APP_ID                 Your Meta App's numeric App ID (Meta Developer Portal → App Settings → Basic)
#   META_APP_SECRET             Your Meta App's App Secret (same page, click "Show")
#   META_WEBHOOK_VERIFY_TOKEN   Any random string YOU choose — must match exactly what you type
#                               in Meta Developer Portal → Webhooks → Edit → "Verify Token"
#   META_GRAPH_API_VERSION      Graph API version (default v21.0 — update when Meta deprecates)
#   META_EMBEDDED_SIGNUP_CONFIG  WhatsApp Embedded Signup config ID (Meta → WhatsApp → Embedded Signup)
#
#   BASE_URL                    Public URL of this server. In dev use your ngrok URL
#                               (e.g. https://abc123.ngrok.io). In prod use your domain.
#
#   Webhook Callback URL to enter in Meta Developer Portal:
#     {BASE_URL}/channels/webhook
#   e.g. https://abc123.ngrok.io/channels/webhook
#
#   Subscribed fields to enable in Meta Developer Portal:
#     Page object     → messages
#     Instagram object → messages
#     WhatsApp Business Account → messages
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_EMBEDDED_SIGNUP_CONFIG_ID=
BASE_URL=https://your-ngrok-url.ngrok.io
#
#   META_SYSTEM_USER_TOKEN   Never-expiring system user token from Meta Business Manager.
#                            Generated via Settings → System users → biplab → Generate token
#                            → Enrichment app → Expiry: Never → Permissions: instagram_basic,
#                            instagram_manage_messages. Replaces the 60-day OAuth long-lived
#                            token for Instagram DMs. Used as the bearer token in Graph API
#                            calls instead of per-connection credentials.
META_SYSTEM_USER_TOKEN=

# Channel credential encryption (AES-256-GCM key stored as base64, 32 bytes)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

# External enrichment APIs (modules not yet wired — reserved placeholders)
SUREPASS_API_KEY=
PROBE42_API_KEY=
NEWSCATCHER_API_KEY=
SERPER_API_KEY=

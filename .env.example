# Application
ENV=development
LOG_LEVEL=INFO

# Database (asyncpg). Host "postgres" is the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/leadengine

# Redis (cache + queue). Host "redis" is the docker-compose service name.
REDIS_URL=redis://redis:6379/0

# Groq (LLM — function calling for the onboarding agents)
GROQ_API_KEY=

# SerpAPI (Google Search — used by tenant onboarding pipeline to discover website pages)
SERPAPI_API_KEY=

# Auth0 (managed auth provider — see auth/)
#   AUTH0_DOMAIN         e.g. your-tenant.us.auth0.com  (no https://, no trailing slash)
#   AUTH0_AUDIENCE       the API Identifier from Auth0 -> APIs
#   AUTH0_SPA_CLIENT_ID  SPA app Client ID, used by the /docs "Authorize" button
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_SPA_CLIENT_ID=
# AUTH_CLAIM_NAMESPACE defaults to https://leadengine/ — override only if your Auth0 Action uses another namespace.
# AUTH0_ALGORITHMS defaults to ["RS256"] — override (JSON list) only if needed.

# External enrichment APIs (modules not yet wired — reserved placeholders)
SUREPASS_API_KEY=
PROBE42_API_KEY=
NEWSCATCHER_API_KEY=
SERPER_API_KEY=

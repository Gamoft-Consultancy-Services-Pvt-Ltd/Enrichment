# =============================================================================
# Lead Intelligence Engine — environment template
# Copy this file to .env and fill in every blank value before running.
# NEVER commit .env to git.
# =============================================================================

# Application
ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (asyncpg)
#
#   Docker Compose  → use service names as host (postgres / redis)
#   Local-only dev  → change host to localhost
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/leadengine

# -----------------------------------------------------------------------------
# Redis (cache + ARQ job queue)
#
#   Docker Compose  → use service name: redis://redis:6379/0
#   Local-only dev  → use 127.0.0.1 (NOT localhost — on Windows, localhost
#                     resolves to ::1 IPv6 but Docker only binds IPv4)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Groq — LLM for Stage 2 noise filter (required for live WhatsApp/Instagram)
#
#   1. Sign up at https://console.groq.com
#   2. API Keys → Create API Key
#   Model used: llama-3.3-70b-versatile (temperature=0, function calling)
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Langfuse — self-hosted AI observability (UI at http://localhost:3000)
#
#   Create a local account + project there, then paste the project's keys.
#   Empty keys disable tracing entirely.
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# -----------------------------------------------------------------------------
# PAN KYB — identity verification via Sandbox/Quicko (clients/pan_client.py)
#
#   PAN_USE_MOCK=true keeps onboarding working with no provider credentials.
#   Set it to false and fill the key/secret + base URL once available.
#   PAN_BASE_URL: https://test-api.sandbox.co.in (sandbox) or https://api.sandbox.co.in
# -----------------------------------------------------------------------------
PAN_USE_MOCK=true
PAN_API_KEY=
PAN_API_SECRET=
PAN_BASE_URL=

# -----------------------------------------------------------------------------
# Auth0 — managed authentication (JWT verification for all authenticated routes)
#
#   AUTH0_DOMAIN      Auth0 Dashboard → Settings → Domain
#                     Format: your-tenant.region.auth0.com  (no https://)
#   AUTH0_AUDIENCE    Auth0 Dashboard → APIs → your API → API Identifier (URL)
#   AUTH0_SPA_CLIENT_ID  Auth0 Dashboard → Applications → your SPA app → Client ID
#
#   Auth0_ALGORITHMS defaults to ["RS256"] — override only if needed.
#   AUTH_CLAIM_NAMESPACE defaults to https://leadengine/ — override only if your
#   Auth0 Action uses a different namespace for custom claims.
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_SPA_CLIENT_ID=
# Management API — Machine-to-Machine app in Auth0
# Used by POST /onboarding to set app_metadata (role=TENANT, tenant_id) on the user
# so their next JWT carries the right claims without manual intervention.
# Create at: Auth0 Dashboard → Applications → Create → Machine to Machine
# Scopes needed: update:users, update:users_app_metadata
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# AUTH_CLAIM_NAMESPACE: namespace prefix for custom claims in Auth0 JWT tokens.
# Must match the namespace set in your Auth0 Action. Default is fine unless changed.
AUTH_CLAIM_NAMESPACE=https://leadengine/

# -----------------------------------------------------------------------------
# Meta / Facebook — webhooks + OAuth for WhatsApp, Instagram, Facebook DMs
#
#   The team shares one Meta developer account. App IDs and Config IDs are
#   public identifiers (they appear in client-side JS) — safe to commit here.
#   App SECRETS must stay blank; get them from a teammate or the Meta portal.
#
#   META_APP_SECRET
#       Meta Developer Portal → App "Enrichment" → App Settings → Basic
#       → click "Show" next to App Secret
#       ⚠ Never commit the actual secret value here.
#
#   META_WEBHOOK_VERIFY_TOKEN
#       The shared verify token already configured in Meta's Webhooks panel.
#       Get it from a teammate (stored in team password manager / 1Password).
#       ⚠ Never commit the actual token value here.
#
#   META_GRAPH_API_VERSION
#       Keep at v21.0 unless Meta deprecates it.
#
#   BASE_URL
#       Each developer uses their own ngrok HTTPS URL locally.
#       Restart ngrok → update this value + re-register webhook callback in Meta.
#       Production: your domain, e.g. https://api.leadengine.io
#
#   Webhook Callback URL to register in Meta Developer Portal:
#       {BASE_URL}/channels/webhook
#   e.g. https://abc123.ngrok-free.app/channels/webhook
#
#   Subscribed Webhook fields to enable:
#       Page object            → messages, leadgen
#       Instagram object       → messages
#       WhatsApp Business Acct → messages
# -----------------------------------------------------------------------------
META_APP_ID=1494580908551596
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_EMBEDDED_SIGNUP_CONFIG_ID=1311452217634130

# -----------------------------------------------------------------------------
# Meta / Instagram — Instagram Business Login (separate app: "Enrichment-IG")
#
#   Same Meta account, separate app for Instagram Business Login API.
#
#   META_IG_APP_SECRET
#       Meta Developer Portal → switch to app "Enrichment-IG"
#       → App Settings → Basic → click "Show" next to App Secret
#       ⚠ Never commit the actual secret value here.
#
#   Redirect URI registered in "Enrichment-IG" app:
#       {BASE_URL}/channels/oauth/instagram/callback
# -----------------------------------------------------------------------------
META_IG_APP_ID=1510242517263430
META_IG_APP_SECRET=

# -----------------------------------------------------------------------------
# BASE_URL — public-facing URL of this server (used in OAuth redirect URIs)
# -----------------------------------------------------------------------------
BASE_URL=https://your-ngrok-url.ngrok-free.app

# -----------------------------------------------------------------------------
# Channel credential encryption — AES-256-GCM
#
#   Protects OAuth tokens stored in channel_connections.credentials_encrypted.
#
#   Generate a fresh key:
#       python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
#   WARNING: if you rotate this key after tenants have connected, all stored
#   credentials become unreadable. Back up the old key before rotating.
# -----------------------------------------------------------------------------
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Data lifecycle retention (COMP-302)
#
#   LEAD_DATA_RETENTION_DAYS    How many days to keep lead + touchpoint PII before
#                               anonymisation. Default 730 (2 years). Reduce to meet
#                               stricter regional requirements (e.g. DPDPA India).
#   INTAKE_LOG_RETENTION_DAYS   How many days to keep raw intake_event_logs before
#                               purging. Default 180 (6 months).
# -----------------------------------------------------------------------------
LEAD_DATA_RETENTION_DAYS=730
INTAKE_LOG_RETENTION_DAYS=180

# -----------------------------------------------------------------------------
# External enrichment APIs (modules not yet wired — reserved placeholders)
#
#   SERPER_API_KEY    https://serper.dev → API Keys
#   SUREPASS_API_KEY  https://surepass.io → Dashboard → API Key
#   PROBE42_API_KEY   https://probe42.in → contact sales for API access
#   NEWSCATCHER_API_KEY  https://newscatcherapi.com → Dashboard → API Keys
# -----------------------------------------------------------------------------
SERPER_API_KEY=
SUREPASS_API_KEY=
PROBE42_API_KEY=
NEWSCATCHER_API_KEY=

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/leadengine

# Redis (cache + queue)
REDIS_URL=redis://redis:6379/0

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Session
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# External APIs
SUREPASS_API_KEY=
PROBE42_API_KEY=
NEWSCATCHER_API_KEY=
SERPER_API_KEY=
ANTHROPIC_API_KEY=
